{
  "fileVersion": "v1.0",
  "copyright": "© SCOUT SYSTEM",
  "source": {
    "zh": "《童軍支部訓練綱要》附錄「小隊隊名及隊色」（P.199）及「童軍小隊隊徽及小隊章」（P.200–202）",
    "en": "Scout Section Training Scheme, appendix “Patrol Names & Colours” (p.199) and “Patrol Animal Images and Badges” (pp.200–202)",
    "pages": "199–202"
  },
  "artCredit": {
    "zh": "小隊章圖案取自《童軍支部訓練綱要》P.200–202（香港童軍總會）；每個章由原文件向量圖直接轉成細圖，冇改色。",
    "en": "Patrol badge artwork from the Scout Section Training Scheme pp.200–202 (Scout Association of Hong Kong), rendered straight from the document's vector drawings without recolouring."
  },
  "notes": [
    {
      "id": "merlin",
      "zh": "隼（Merlin）隊色：綱要中文印作「藍棘紅」，英文為 Royal Blue and Marron（Maroon）；模型寫作「藍棗紅」，顏色照圖。",
      "en": "Merlin: the Chinese text prints 藍棘紅 and the English “Royal Blue and Marron” (maroon); the app writes 藍棗紅 and uses the printed colours."
    },
    {
      "id": "woodPigeon",
      "zh": "斑鳩：P.202 印作「班鳩」，P.199 印作「斑鳩」；模型用「斑鳩」。",
      "en": "Wood Pigeon: p.202 prints 班鳩 and p.199 prints 斑鳩; the app uses 斑鳩."
    },
    {
      "id": "birdNames",
      "zh": "P.199 有幾隊中文同名（例如鷹、鷸），模型用 P.200–202 括號內嘅名（例如「鷹（獵鷹）」）分開。",
      "en": "Several patrols share a Chinese name on p.199 (e.g. 鷹, 鷸); the app uses the bracketed names from pp.200–202 (e.g. 鷹（獵鷹）) to tell them apart."
    }
  ],
